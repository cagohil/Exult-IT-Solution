# Copy to .env.local for local dev. On Netlify, add these under
# Site configuration -> Environment variables. Never commit real values.

# --- Office 365 SMTP (nodemailer) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=admin@exultitsolution.com
SMTP_PASS=

# Who receives contact-form submissions (comma-separated for several)
CONTACT_TO=chirag.gohil@exultitsolution.com
# Optional CC (comma-separated)
CONTACT_CC=
# "From" address; must be a mailbox SMTP_USER is allowed to send as
CONTACT_FROM=admin@exultitsolution.com

# --- Cloudflare Turnstile captcha ---
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Add your domains (exultitsolution.com, exultitsolution.netlify.app, localhost).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public site URL, used for canonical links and the sitemap
NEXT_PUBLIC_SITE_URL=https://exultitsolution.com
